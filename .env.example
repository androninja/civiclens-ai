# ==============================================================================
# CivicLens AI — Environment Configuration Template
# AI Builder Cup 2026 (Sustainability & Social Impact)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Configuration (Google AI Studio or Vertex AI)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# When empty, CivicLens AI runs in self-contained deterministic fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Database Connection Strings
# ------------------------------------------------------------------------------
# By default, CivicLens AI runs on SQLite (Data Source=civiclens.db).
# For production Cloud SQL PostgreSQL / PostGIS:
# Host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME;Database=civiclens;Username=postgres;Password=YOUR_SECURE_PASSWORD
ConnectionStrings__DefaultConnection=Data Source=civiclens.db
ConnectionStrings__PostgresConnection=Host=localhost;Database=civiclens;Username=postgres;Password=postgres

# ------------------------------------------------------------------------------
# 3. Google Cloud Platform Configuration
# ------------------------------------------------------------------------------
GoogleCloud__ProjectId=civiclens-ai-2026
GoogleCloud__Region=us-central1
# Leave empty to use local media storage (/uploads) in development
GoogleCloud__StorageBucket=

# ------------------------------------------------------------------------------
# 4. JWT Authentication
# ------------------------------------------------------------------------------
Jwt__Key=CivicLens_AI_Master_Secret_Key_For_Hackathon_2026_Signing_Key_12345
Jwt__Issuer=CivicLensApi
Jwt__Audience=CivicLensClient

# ------------------------------------------------------------------------------
# 5. Service URLs
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:4200
